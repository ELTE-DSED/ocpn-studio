{
  "name": "OCPN Studio",
  "version": "0.8.4",
  "homepage": "https://elte-dsed.github.io/ocpn-studio",
  "description": "OCPN Studio is a web application for designing, simulating and analyzing Object-Centric Petri Nets",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx,js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "prepare": "husky",
    "clean": "vite --force",
    "cpnsim:local": "node scripts/cpnsim.mjs local",
    "cpnsim:restore": "node scripts/cpnsim.mjs restore",
    "cpnsim:status": "node scripts/cpnsim.mjs status"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@hcaptcha/react-hcaptcha": "^2.0.2",
    "@mathigon/euclid": "^1.2.4",
    "@radix-ui/react-accordion": "^1.2.16",
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-collapsible": "^1.1.16",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-label": "^2.1.11",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-radio-group": "^1.4.3",
    "@radix-ui/react-scroll-area": "^1.2.14",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-slider": "^1.4.3",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.17",
    "@radix-ui/react-toggle": "^1.1.14",
    "@radix-ui/react-toggle-group": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@radix-ui/react-visually-hidden": "^1.2.7",
    "@rwth-pads/cpnsim": "^0.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@xyflow/react": "^12.11.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "elkjs": "^0.12.0",
    "globals": "^17.7.0",
    "lucide-react": "^1.25.0",
    "ocpn-viz": "git+https://github.com/rwth-pads/ocpn-viz-npm.git",
    "react": "^19.2.7",
    "react-colorful": "^5.8.0",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.2",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.1",
    "zundo": "^2.3.0",
    "zustand": "^5.0.14"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.5"
  },
  "packageManager": "pnpm@10.34.5",
  "overrides": {
    "rollup": ">=4.59.0"
  },
  "pnpm": {
    "overrides": {
      "rollup": ">=4.59.0"
    }
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": "eslint --cache --fix"
  }
}
