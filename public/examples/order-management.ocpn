  "functions": [
    {
      "id": "fn-shift",
      "name": "shift_delay",
      "code": "fn shift_midnight(t) {\n    // Absolute midnight of t's day, expressed in simulation time. hour_of_day and\n    // friends report the wall clock, so subtracting them is epoch-alignment safe.\n    t - hour_of_day(t) * 3600000 - minute_of_hour(t) * 60000 - second_of_minute(t) * 1000\n}\n\nfn snap_to_shift(t, from_h, to_h) {\n    // First instant at or after t that falls inside [from_h, to_h) on a working day.\n    // This is the whole of sim-utils.sml's at_*/st_* intensity machinery, expressed\n    // with the simulator's own calendar predicates: work does not happen at night or\n    // at the weekend, so a delay landing there waits for the next shift to open.\n    let x = t;\n    let guard = 0;\n    while guard < 10 {\n        let h = hour_of_day(x);\n        if is_workday(x) && h >= from_h && h < to_h { return x; }\n        if is_workday(x) && h < from_h {\n            x = shift_midnight(x) + from_h * 3600000;      // earlier the same day\n        } else {\n            x = shift_midnight(x) + 86400000 + from_h * 3600000;  // after hours or weekend\n        }\n        guard += 1;\n    }\n    x\n}\n\nfn shift_delay(base, from_h, to_h) {\n    // Delay that lands the produced token inside the next shift. Work that had to wait\n    // for the shift to open is spread across it rather than fired at the opening second:\n    // the legacy model gets that spread from consuming delays in working time, which is\n    // the behaviour this approximates. 55 min per shift-hour keeps the jitter inside the\n    // window.\n    let due = current_time() + base;\n    let open = snap_to_shift(due, from_h, to_h);\n    if open > due { open = open + delay_min(uniform(0.0, (to_h - from_h) * 55.0).to_int()); }\n    open - current_time()\n}"
    }
  ],
