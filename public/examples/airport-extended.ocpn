          "guard": "n > 0",
          "time": "",
          "priority": "P_HIGH",
          "codeSegment": "let uld = #{ id: tr.arr.id + \"-U\" + n, kind: uld_kind(tr.arr.aircraft.body, n), weightKg: (uniform(180.0, 1150.0) * 10.0).round() / 10.0, flight: tr.arr.id };",
          "position": {
            "x": 1080,
            "y": 120
          },
          "size": {
            "width": 78,
            "height": 46
          },
          "includeInOcel": true
        },
