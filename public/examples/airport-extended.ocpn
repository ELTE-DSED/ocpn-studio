        {
          "id": "s-t-file",
          "name": "File Flight Plan\n(M1)",
          "guard": "",
          "time": "",
          "priority": "",
          "codeSegment": "// One inbound leg enters the day's schedule, flown by an airframe taken from the\n// based fleet. Which aircraft is free decides the equipment and the operator; only\n// the sector and the passenger load are drawn here.\nlet long_haul = ac.body == \"wide\" || ac.body == \"superheavy\";\nlet schengen = if long_haul { false } else { bernoulli(0.62) == 1 };\nlet fl = make_flight(k, \"ARR\", ac, schengen, long_haul);",
          "position": {
            "x": 290,
            "y": 200
          },
          "size": {
            "width": 78,
            "height": 46
          },
          "includeInOcel": true
        }
      ],
