  "functions": [
    {
      "id": "fn-dist_m",
      "name": "dist_m",
      "code": "fn dist_m(x1, y1, x2, y2) {\n    // Straight-line apron distance in metres. Service roads are not straight, so\n    // callers apply a routing factor on top.\n    let dx = x2.to_float() - x1.to_float();\n    let dy = y2.to_float() - y1.to_float();\n    (dx * dx + dy * dy).sqrt()\n}"
    },
    {
      "id": "fn-drive_min",
      "name": "drive_min",
      "code": "fn drive_min(x1, y1, x2, y2) {\n    // Ground-vehicle driving time between two apron positions. Apron service roads\n    // are speed-limited (30 km/h, less near stands); 22 km/h average = 367 m/min.\n    // 1.35 routing factor for the road layout, plus positioning/chocking at the stand.\n    let d = dist_m(x1, y1, x2, y2) * 1.35;\n    // Already standing at the aircraft (e.g. an ambulift making a second trip for the\n    // next assisted passenger): no repositioning, just the manoeuvre onto the sill.\n    if d < 50.0 { return 0.2; }\n    let t = d / 367.0 + 1.5;\n    if t < 1.0 { 1.0 } else { t }\n}"
    },
    {
      "id": "fn-drive_sec_between",
      "name": "drive_sec_between",
      "code": "fn drive_sec_between(x1, y1, x2, y2) {\n    // Driving time in seconds, so it can be added to service durations before being\n    // wrapped in a single delay_sec(...) on the arc.\n    (drive_min(x1, y1, x2, y2) * 60.0).to_int()\n}"
    },
    {
      "id": "fn-code_rank",
      "name": "code_rank",
      "code": "fn code_rank(c) {\n    // ICAO aerodrome reference code letter as an ordinal, so stand/tug capability\n    // can be compared against the aircraft that needs it.\n    if c == \"A\" { 1 } else if c == \"B\" { 2 } else if c == \"C\" { 3 }\n    else if c == \"D\" { 4 } else if c == \"E\" { 5 } else { 6 }\n}"
    },
    {
      "id": "fn-stand_fits",
      "name": "stand_fits",
      "code": "fn stand_fits(st, ac, schengen) {\n    // A stand must be big enough for the code letter and on the right side of the\n    // Schengen border. Remote stands (\"B\") are bussed to either terminal.\n    let sr = code_rank(st.maxCode);\n    let ar = code_rank(ac.codeLetter);\n    // Big enough, but not wastefully big: a code-E stand is not given to a turboprop\n    // while wide-bodies are waiting for one.\n    if sr < ar || sr > ar + 1 { return false; }\n    if st.schengen == \"B\" { return true; }\n    if schengen { st.schengen == \"S\" } else { st.schengen == \"N\" }\n}"
    },
    {
      "id": "fn-runway_fits",
      "name": "runway_fits",
      "code": "fn runway_fits(rw, ac) {\n    // Take-off run required: regional/narrow-bodies work off the shorter runway,\n    // wide-bodies and the A380 need the long one.\n    let need = if ac.body == \"regional\" { 1800 }\n               else if ac.body == \"narrow\" { 2400 }\n               else if ac.body == \"wide\" { 3000 }\n               else { 3300 };\n    rw.lengthM >= need\n}"
    },
    {
      "id": "fn-uplift_l",
      "name": "uplift_l",
      "code": "fn uplift_l(body, sector_min) {\n    // Trip fuel plus reserves (contingency + alternate + final reserve ~ 12% + fixed).\n    // Cruise burn per minute: E190/ATR ~ 22 L, A320/B738 ~ 42 L, A330/B789 ~ 125 L, A380 ~ 220 L.\n    let burn = if body == \"regional\" { 22.0 }\n               else if body == \"narrow\" { 42.0 }\n               else if body == \"wide\" { 125.0 }\n               else { 220.0 };\n    let trip = burn * sector_min.to_float();\n    (trip * 1.12 + 1200.0).to_int()\n}"
    },
    {
      "id": "fn-accept_lpm",
      "name": "accept_lpm",
      "code": "fn accept_lpm(body) {\n    // What the aircraft itself will take through its single-point refuelling coupling.\n    // A narrow-body accepts far less than a hydrant dispenser can deliver, so on those\n    // the aircraft is the bottleneck; on a wide-body the dispenser type starts to matter.\n    if body == \"regional\" { 700 }\n    else if body == \"narrow\" { 1100 }\n    else if body == \"wide\" { 3000 }\n    else { 4000 }\n}"
    },
    {
      "id": "fn-fuel_sec",
      "name": "fuel_sec",
      "code": "fn fuel_sec(litres, rate_lpm, body) {\n    // Bonding, hose connection and metering, pumping at whichever of the dispenser and\n    // the aircraft manifold is slower, then disconnect and paperwork. Hydrant dispensers\n    // run ~2500 L/min and tankers ~1200 L/min, against a narrow-body's ~1100 L/min intake.\n    let acc = accept_lpm(body);\n    let rate = if rate_lpm < acc { rate_lpm } else { acc };\n    let pump = litres.to_float() / rate.to_float();\n    ((4.0 + pump + 3.0) * 60.0).to_int()\n}"
    },
    {
      "id": "fn-deboard_sec",
      "name": "deboard_sec",
      "code": "fn deboard_sec(body, pax, contact) {\n    // Deplaning rate scales with the number of usable doors. A single airbridge on a\n    // narrow-body clears ~20 pax/min; a remote stand with front and rear stairs is\n    // faster (the bus cycle is added on top); a wide-body uses two bridges.\n    let rate = if body == \"regional\" { 15.0 }\n               else if body == \"narrow\" { 20.0 }\n               else if body == \"wide\" { 35.0 }\n               else { 50.0 };\n    if !contact { rate = rate * 1.35; }\n    ((2.0 + pax.to_float() / rate) * 60.0).to_int()\n}"
    },
    {
      "id": "fn-board_sec",
      "name": "board_sec",
      "code": "fn board_sec(body, pax, contact) {\n    // Boarding is slower than deplaning: hand baggage stowage and seat finding.\n    let rate = if body == \"regional\" { 11.0 }\n               else if body == \"narrow\" { 13.0 }\n               else if body == \"wide\" { 22.0 }\n               else { 30.0 };\n    if !contact { rate = rate * 1.2; }\n    ((4.0 + pax.to_float() / rate) * 60.0).to_int()\n}"
    },
    {
      "id": "fn-bus_sec",
      "name": "bus_sec",
      "code": "fn bus_sec(pax, cap) {\n    // Apron bus transfer between the terminal and a remote stand. Two or three buses\n    // are dispatched to the same aircraft and run their loads concurrently, so the\n    // transfer costs a whole cycle per *wave* of buses, not per bus run.\n    let runs = (pax + cap - 1) / cap;\n    if runs < 1 { runs = 1; }\n    let parallel = if runs > 2 { 3 } else { 2 };\n    let waves = (runs + parallel - 1) / parallel;\n    (waves.to_float() * 7.0 * 60.0).to_int()\n}"
    },
    {
      "id": "fn-prm_sec",
      "name": "prm_sec",
      "code": "fn prm_sec(contact) {\n    // One assisted passenger. At a contact stand an agent with an aisle/transit chair\n    // takes ~2 min; at a remote stand the ambulift has to be raised to the door sill\n    // and lowered again, ~4 min per passenger.\n    let per = if contact { 2.0 } else { 4.0 };\n    (per * 60.0).to_int()\n}"
    },
    {
      "id": "fn-clean_sec",
      "name": "clean_sec",
      "code": "fn clean_sec(body, carrier_type) {\n    // Cabin cleaning. A low-cost turnaround runs a \"security/tidy\" clean by the crew\n    // and a small team; a full-service carrier does a deeper clean between rotations.\n    // Reported A319 full cleans run ~18 min, wide-bodies considerably longer.\n    let base = if body == \"regional\" { 300 }\n               else if body == \"narrow\" { 480 }\n               else if body == \"wide\" { 1200 }\n               else { 1800 };\n    let spread = if carrier_type == \"low\" { discrete(60, 300) } else { discrete(420, 900) };\n    base + spread\n}"
    },
    {
      "id": "fn-cater_sec",
      "name": "cater_sec",
      "code": "fn cater_sec(body, sector_min) {\n    // Catering uplift at the galley doors, in parallel with deplaning. Long sectors\n    // carry full meal service and take considerably longer to load.\n    let base = if body == \"regional\" { 240 }\n               else if body == \"narrow\" { 420 }\n               else if body == \"wide\" { 1080 }\n               else { 1500 };\n    let extra = if sector_min > 300 { discrete(600, 1200) } else { discrete(60, 300) };\n    base + extra\n}"
    },
    {
      "id": "fn-hold_kind",
      "name": "hold_kind",
      "code": "fn hold_kind(type_code, carrier_type) {\n    // Whether the hold takes containers at all is a property of the airframe, not of\n    // its size class. The 737 family has no containerised hold - the cross-section is\n    // too small for LD-type containers - so every bag goes in loose off a belt loader,\n    // and the same is true of the regional jets and turboprops. The A320 family *can*\n    // take the reduced-height LD3-45 (AKH) container and network carriers use it, while\n    // the low-cost operators bulk-load to avoid the container handling.\n    if type_code == \"A333\" || type_code == \"B789\" || type_code == \"A388\" { return \"container\"; }\n    if type_code == \"A320\" || type_code == \"A321\" {\n        return if carrier_type == \"low\" { \"bulk\" } else { \"container\" };\n    }\n    \"bulk\"\n}"
    },
    {
      "id": "fn-uld_count",
      "name": "uld_count",
      "code": "fn uld_count(hold, body, pax) {\n    // Bulk-loaded aircraft carry no containers at all: the unit of handling is the\n    // individual bag, so there is nothing here to become a ULD object.\n    if hold == \"bulk\" { return 0; }\n    let base = if body == \"wide\" { 12 } else if body == \"superheavy\" { 22 } else { 3 };\n    base + pax / 60\n}"
    },
    {
      "id": "fn-uld_kind",
      "name": "uld_kind",
      "code": "fn uld_kind(body, n) {\n    // The A320 family takes the reduced-height LD3-45, coded AKH. Wide-bodies take\n    // full-height LD3 (AKE) with pallets for the heavier freight.\n    if body == \"wide\" || body == \"superheavy\" {\n        if n % 4 == 0 { \"PMC\" } else { \"AKE\" }\n    } else { \"AKH\" }\n}"
    },
    {
      "id": "fn-loader_fits",
      "name": "loader_fits",
      "code": "fn loader_fits(loader_kind, hold) {\n    // Loose bags come off a belt loader; containers need a high loader that lifts the\n    // whole ULD to the sill. Neither can do the other's job.\n    if hold == \"bulk\" { loader_kind == \"belt\" } else { loader_kind == \"container\" }\n}"
    },
    {
      "id": "fn-hold_sec",
      "name": "hold_sec",
      "code": "fn hold_sec(hold, pax, ulds, loading) {\n    // A bulk hold is worked bag by bag off a belt loader, so it scales with the number\n    // of bags; a containerised hold moves a few big boxes with a high loader. Loading\n    // is slower than unloading in both cases - bags have to be stacked and secured.\n    if hold == \"bulk\" {\n        let per = if loading { 2.6 } else { 2.1 };\n        (180.0 + pax.to_float() * 1.3 * per).to_int()\n    } else {\n        let per = if loading { 115.0 } else { 95.0 };\n        (240.0 + ulds.to_float() * per).to_int()\n    }\n}"
    },
    {
      "id": "fn-hash01",
      "name": "hash01",
      "code": "fn hash01(n) {\n    // Deterministic pseudo-random value in [0,1) from an integer. Weather has to be a\n    // function of *time*, not a fresh draw per flight: otherwise two aircraft pushing\n    // back a minute apart get their own private weather.\n    let x = (n * 1103515245 + 12345) & 2147483647;\n    x = (x ^ (x >> 16)) * 40503;\n    x = x & 2147483647;\n    (x % 100000).to_float() / 100000.0\n}"
    },
    {
      "id": "fn-smooth_noise",
      "name": "smooth_noise",
      "code": "fn smooth_noise(pos, seed) {\n    // Value noise: pick a random value per whole unit of `pos` and interpolate between\n    // them with a smoothstep. The result is continuous and autocorrelated, so the signal\n    // drifts instead of jumping - which is what makes a cold spell a spell.\n    let i = pos.floor();\n    let f = pos - i;\n    let a = hash01(i.to_int() * 7919 + seed);\n    let b = hash01((i.to_int() + 1) * 7919 + seed);\n    let s = f * f * (3.0 - 2.0 * f);\n    a + (b - a) * s\n}"
    },
    {
      "id": "fn-seasonal_mean_c",
      "name": "seasonal_mean_c",
      "code": "fn seasonal_mean_c(t) {\n    // Monthly mean temperatures for a continental Central-European climate.\n    // Index 0 is unused; month() returns 1-12.\n    let means = [1.5, 0.2, 2.0, 6.5, 12.0, 17.0, 20.5, 22.5, 22.0, 17.0, 11.5, 5.5, 1.5];\n    means[month(t)]\n}"
    },
    {
      "id": "fn-diurnal_c",
      "name": "diurnal_c",
      "code": "fn diurnal_c(t) {\n    // Daily cycle: coldest shortly before sunrise, warmest mid-afternoon. This is what\n    // puts de-icing on the morning bank and leaves the afternoon departures alone.\n    let h = hour_of_day(t).to_float() + minute_of_hour(t).to_float() / 60.0;\n    4.2 * ((h - 15.0) * 0.2618).cos()\n}"
    },
    {
      "id": "fn-temp_anomaly_c",
      "name": "temp_anomaly_c",
      "code": "fn temp_anomaly_c(t) {\n    // Departure from the seasonal norm: a slow term for air masses that sit over the\n    // region for the best part of a week, plus a faster day-scale term. Both are\n    // continuous in time, so the daily mean moves by about 1.5 K from one day to the\n    // next and never by twenty.\n    let d = t.to_float() / 86400000.0;\n    let slow = (smooth_noise(d / 5.5, 11) - 0.5) * 2.0;\n    let fast = (smooth_noise(d / 1.2, 29) - 0.5) * 2.0;\n    slow * 5.5 + fast * 3.2\n}"
    },
    {
      "id": "fn-temp_c",
      "name": "temp_c",
      "code": "fn temp_c(t) {\n    // Outside air temperature at the airport, in degrees Celsius.\n    seasonal_mean_c(t) + diurnal_c(t) + temp_anomaly_c(t)\n}"
    },
    {
      "id": "fn-precip_at",
      "name": "precip_at",
      "code": "fn precip_at(t) {\n    // Precipitation comes in episodes lasting hours, on its own continuous signal.\n    let d = t.to_float() / 86400000.0;\n    smooth_noise(d / 0.9, 71) > 0.68\n}"
    },
    {
      "id": "fn-needs_deicing",
      "name": "needs_deicing",
      "code": "fn needs_deicing(t) {\n    // De-icing is a property of the weather at that moment, not of the individual\n    // flight: inside a frost or snow event essentially every departure is treated,\n    // outside one essentially none. Precipitation at or below freezing contaminates\n    // the wing; a damp, clear, hard-frost night deposits enough to need a spray too,\n    // while a dry cold snap leaves the aircraft clean.\n    let temp = temp_c(t);\n    if temp > 3.0 { return false; }\n    if precip_at(t) && temp <= 1.0 { return true; }\n    let d = t.to_float() / 86400000.0;\n    smooth_noise(d / 1.3, 137) > 0.55 && temp <= -2.0\n}"
    },
    {
      "id": "fn-demand_weight",
      "name": "demand_weight",
      "code": "fn demand_weight(h) {\n    // Hourly *arrival* demand at a based-fleet airport. The 05:00-08:00 wave is a\n    // departure bank - aircraft that night-stopped leaving on their first rotation -\n    // so arrivals only build from mid-morning and peak late in the evening as the\n    // fleet comes home. 00:01-05:00 is the night ban; what little moves then is a\n    // permitted exception.\n    if h < 5 { 0.04 }\n    else if h < 6 { 0.15 }\n    else if h < 8 { 0.85 }\n    else if h < 11 { 1.35 }\n    else if h < 16 { 1.05 }\n    else if h < 20 { 1.30 }\n    else if h < 23 { 1.60 }\n    else { 1.05 }\n}"
    },
    {
      "id": "fn-in_night_ban",
      "name": "in_night_ban",
      "code": "fn in_night_ban(t) {\n    // Budapest has banned scheduled movements between 00:01 and 05:00 since 2019.\n    hour_of_day(t) < 5\n}"
    },
    {
      "id": "fn-curfew_delay",
      "name": "curfew_delay",
      "code": "fn curfew_delay(base) {\n    // A departure that would fall inside the night ban becomes a night stop: the\n    // aircraft waits on stand until the airport reopens. This is what produces the\n    // early-morning departure bank rather than aircraft trickling out at 02:00.\n    let due = current_time() + base;\n    if !in_night_ban(due) { return base; }\n    let midnight = due - hour_of_day(due) * 3600000\n                       - minute_of_hour(due) * 60000\n                       - second_of_minute(due) * 1000;\n    // Spread the backlog across the first hour so the whole night does not push back\n    // in the same second.\n    let open = midnight + 5 * 3600000 + discrete(0, 3600) * 1000;\n    open - current_time()\n}"
    },
    {
      "id": "fn-interarrival_sec",
      "name": "interarrival_sec",
      "code": "fn interarrival_sec(t) {\n    // About 175 arrivals a day (350 movements), shaped by the hourly demand profile.\n    // The base interval is scaled by the profile's mean weight (0.933) so the weighted\n    // day sums to the target instead of falling short of it.\n    //\n    // The profile describes when aircraft *land*, but what is being scheduled here is\n    // when the flight plan is filed - one sector earlier. Evaluating the weight at the\n    // expected landing time instead of now is what puts the evening peak in the evening\n    // rather than after midnight.\n    let mean = 461.0 / demand_weight(hour_of_day(t + 125 * 60000));\n    let s = exponential(1.0 / mean).to_int();\n    if s < 45 { 45 } else { s }\n}"
    },
    {
      "id": "fn-load_factor",
      "name": "load_factor",
      "code": "fn load_factor(t, carrier_type) {\n    // How full a flight is has a large systematic component - the airline's business\n    // model, the season, the day of the week, the time of day - and only a modest\n    // per-flight residual. Drawing the whole thing per flight, as a flat uniform, makes\n    // a wet Tuesday in February look exactly like a Saturday in August.\n    let base = if carrier_type == \"low\" { 0.905 } else { 0.820 };\n\n    // Leisure-driven seasonality: a July/August peak, a February trough.\n    // Index 0 unused; month() returns 1-12.\n    let seasonal = [0.0, -0.065, -0.075, -0.030, 0.000, 0.015, 0.038, 0.055, 0.050, 0.025, 0.000, -0.045, -0.015];\n    // Friday and Sunday carry the weekend traffic; midweek is thinner. day_of_week()\n    // returns 0 for Sunday.\n    let weekday = [0.020, -0.020, -0.035, -0.035, -0.005, 0.035, 0.010];\n    // First and last departures of the day are the ones travellers fill first.\n    let h = hour_of_day(t);\n    let daily = if h < 8 { 0.030 } else if h < 11 { 0.005 }\n                else if h < 16 { -0.030 } else if h < 20 { 0.010 } else { 0.030 };\n\n    // normal(mean, variance) - 0.003025 is a standard deviation of 5.5 points.\n    let lf = base + seasonal[month(t)] + weekday[day_of_week(t)] + daily + normal(0.0, 0.003025);\n    if lf > 0.99 { lf = 0.99; }\n    if lf < 0.42 { lf = 0.42; }\n    lf\n}"
    },
    {
      "id": "fn-pick_weighted",
      "name": "pick_weighted",
      "code": "fn pick_weighted(items) {\n    // Weighted draw from an array of maps carrying a \"w\" weight.\n    let total = 0;\n    for it in items { total += it.w; }\n    let r = discrete(1, total);\n    let acc = 0;\n    for it in items {\n        acc += it.w;\n        if r <= acc { return it; }\n    }\n    items[items.len() - 1]\n}"
    },
    {
      "id": "fn-airlines",
      "name": "airlines",
      "code": "fn airlines() {\n    // Fictitious carriers, as in the original Airport Ground Handling example.\n    [\n        #{ w: 22, name: \"BorealJet\",        carrierType: \"low\",  acronym: \"BJ\" },\n        #{ w: 14, name: \"EmberAir\",         carrierType: \"low\",  acronym: \"EA\" },\n        #{ w:  9, name: \"FableFly\",         carrierType: \"low\",  acronym: \"FF\" },\n        #{ w:  7, name: \"OrchidJet\",        carrierType: \"low\",  acronym: \"OJ\" },\n        #{ w:  6, name: \"QuartzAir\",        carrierType: \"low\",  acronym: \"QA\" },\n        #{ w: 10, name: \"AuroraSkies Air\",  carrierType: \"full\", acronym: \"AS\" },\n        #{ w:  8, name: \"Cobalt Wings\",     carrierType: \"full\", acronym: \"CW\" },\n        #{ w:  7, name: \"DawnLine Airways\", carrierType: \"full\", acronym: \"DL\" },\n        #{ w:  6, name: \"HorizonVale Air\",  carrierType: \"full\", acronym: \"HV\" },\n        #{ w:  5, name: \"LumenWings\",       carrierType: \"full\", acronym: \"LW\" },\n        #{ w:  4, name: \"SilverKite\",       carrierType: \"full\", acronym: \"SK\" },\n        #{ w:  2, name: \"Nimbus Coast\",     carrierType: \"full\", acronym: \"NC\" }\n    ]\n}"
    },
    {
      "id": "fn-stations",
      "name": "stations",
      "code": "fn stations(schengen, long_haul) {\n    if long_haul {\n        return [\"Dubai\", \"Doha\", \"New York JFK\", \"Seoul Incheon\", \"Beijing\", \"Shanghai Pudong\", \"Toronto\"];\n    }\n    if schengen {\n        [\"Vienna\", \"Munich\", \"Frankfurt\", \"Paris CDG\", \"Amsterdam\", \"Milan Malpensa\", \"Madrid\",\n         \"Berlin\", \"Zurich\", \"Brussels\", \"Copenhagen\", \"Stockholm Arlanda\", \"Warsaw\", \"Prague\", \"Lisbon\"]\n    } else {\n        [\"London Luton\", \"London Gatwick\", \"Dublin\", \"Istanbul\", \"Belgrade\", \"Bucharest\",\n         \"Kyiv\", \"Tel Aviv\", \"Skopje\", \"Tirana\", \"Manchester\", \"Edinburgh\"]\n    }\n}"
    },
    {
      "id": "fn-airline_of",
      "name": "airline_of",
      "code": "fn airline_of(name) {\n    // The operator is a property of the airframe, so callsign and carrier type are\n    // looked up from it rather than drawn again per leg.\n    for a in airlines() { if a.name == name { return a; } }\n    airlines()[0]\n}"
    },
    {
      "id": "fn-make_flight",
      "name": "make_flight",
      "code": "fn make_flight(seq, dir, ac, schengen, long_haul) {\n    let al = airline_of(ac.airline);\n    // One scheduled flight leg. Load factors run high at a leisure-heavy airport;\n    // PRM demand is ~1.1% of passengers (ACI Europe reports ~1% and rising).\n    let sector = if long_haul { discrete(430, 700) } else { discrete(55, 195) };\n    let pax = (ac.seats.to_float() * load_factor(current_time(), al.carrierType)).to_int();\n    let prm = poisson(pax.to_float() * 0.011);\n    let sts = stations(schengen, long_haul);\n    #{\n        id: dir + \"-\" + seq,\n        callsign: al.acronym + to_string(discrete(100, 999)),\n        airline: al.name,\n        carrierType: al.carrierType,\n        direction: dir,\n        schengen: schengen,\n        station: sts[discrete(0, sts.len() - 1)],\n        pax: pax,\n        prm: prm,\n        sectorMin: sector,\n        aircraft: ac\n    }\n}"
    }
  ],
  "uses": [],
  "values": [],
  "fusionSets": [],
  "monitors": [
    {
      "id": "mon-tat",
      "name": "Turnaround time (AIBT → AOBT)",
      "type": "interval-duration",
      "enabled": true,
      "placeIds": [],
      "transitionIds": [
        "a-t-inblock",
        "d-t-push-start"
      ],
