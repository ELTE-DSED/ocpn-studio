        },
        {
          "id": "a-t-stand-contact",
          "name": "Assign Contact\nStand",
          "guard": "st.contact && stand_fits(st, fl.aircraft, fl.schengen)",
          "time": "",
          "priority": "",
          "codeSegment": "",
          "position": {
            "x": 620,
            "y": 300
          },
          "size": {
            "width": 78,
            "height": 46
          },
          "includeInOcel": true
        },
        {
          "id": "a-t-stand-remote",
          "name": "Assign Remote\nStand",
          "guard": "!st.contact && stand_fits(st, fl.aircraft, fl.schengen)",
          "time": "",
          "priority": "",
          "codeSegment": "",
          "position": {
            "x": 620,
            "y": 430
          },
          "size": {
            "width": 78,
            "height": 46
          },
          "includeInOcel": true
        },
        {
          "id": "a-t-final",
          "name": "Final Approach\n(M5)",
          "guard": "runway_fits(rw, fl.aircraft)",
          "time": "",
          "priority": "",
          "codeSegment": "// The turnaround object is created once the stand is known: from here on the\n// inbound leg, the outbound leg, the airframe and the stand travel together.\nlet dep_lh = fl.aircraft.body == \"wide\" || fl.aircraft.body == \"superheavy\";\nlet dep = make_flight(fl.id.sub_string(4), \"DEP\", fl.aircraft, fl.schengen, dep_lh);\nlet tr = #{\n    id: \"TA-\" + fl.id.sub_string(4),\n    arr: fl,\n    dep: dep,\n    stand: st,\n    upliftL: uplift_l(fl.aircraft.body, dep.sectorMin),\n    hold: hold_kind(fl.aircraft.typeCode, fl.carrierType),\n    ulds: uld_count(hold_kind(fl.aircraft.typeCode, fl.carrierType), fl.aircraft.body, fl.pax),\n    depUlds: uld_count(hold_kind(fl.aircraft.typeCode, fl.carrierType), fl.aircraft.body, dep.pax),\n    // Which optional services this rotation needs is decided once, here, so that the\n    // guards downstream are deterministic: a die rolled separately in two mutually\n    // exclusive guards can come up \"no\" in both and strand the token.\n    needCater: if dep_lh || fl.aircraft.body == \"wide\" || fl.aircraft.body == \"superheavy\" { true }\n               else if fl.carrierType == \"full\" { bernoulli(0.85) == 1 }\n               else { bernoulli(0.35) == 1 },\n    needWater: if dep.sectorMin > 300 { true } else { bernoulli(0.55) == 1 }\n};",
          "position": {
            "x": 870,
            "y": 300
          },
          "size": {
            "width": 78,
            "height": 46
          },
          "includeInOcel": true
        },
        {
          "id": "a-t-land",
          "name": "Landing\n(M6 · ALDT)",
          "guard": "",
          "time": "",
          "priority": "",
          "codeSegment": "",
          "position": {
            "x": 1130,
            "y": 300
          },
          "size": {
            "width": 78,
            "height": 46
          },
          "includeInOcel": true
        },
        {
          "id": "a-t-vacate",
          "name": "Vacate Runway",
          "guard": "",
          "time": "",
          "priority": "",
